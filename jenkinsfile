pipeline {
    agent any

    environment {
        FLUTTER_HOME = "/var/lib/jenkins/flutter_sdk"
        PATH = "${FLUTTER_HOME}/bin:${FLUTTER_HOME}/bin/cache/dart-sdk/bin:${env.PATH}"
    }

    stages {
        stage('Setup Flutter') {
            steps {
                sh '''
                    # Clone Flutter SDK if not already cached
                    if [ ! -d "$FLUTTER_HOME" ]; then
                        git clone https://github.com/flutter/flutter.git -b stable "$FLUTTER_HOME"
                    fi

                    # Prevent git dubious ownership errors
                    git config --global --add safe.directory "$FLUTTER_HOME"

                    flutter --version
                    flutter doctor -v
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'flutter pub get'
            }
        }

        stage('Analyze & Lint') {
            steps {
                sh 'flutter analyze'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'flutter test'
            }
        }

        stage('Build Web') {
            steps {
                // Build the production web bundle
                sh 'flutter build web --release'
            }
        }

        stage('Archive Artifacts') {
            steps {
                // Package the build/web directory into a single tarball
                sh 'tar -czf flutter-web.tar.gz -C build/web .'
                archiveArtifacts artifacts: 'flutter-web.tar.gz', fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'Flutter build succeeded!'
        }
        failure {
            echo 'Flutter build failed. Check console output.'
        }
    }
}