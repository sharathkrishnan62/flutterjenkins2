pipeline {
    agent any

    environment {
        FLUTTER_HOME = "/var/lib/jenkins/flutter_sdk"
        PATH = "${FLUTTER_HOME}/bin:${FLUTTER_HOME}/bin/cache/dart-sdk/bin:${env.PATH}"
    }

    stages {
        stage('Install Dependencies') {
            steps {
                sh 'flutter pub get'
            }
        }

        stage('Analyze') {
            steps {
                sh 'flutter analyze'
            }
        }

        stage('Test') {
            steps {
                sh 'flutter test'
            }
        }

        stage('Build Web') {
            steps {
                sh 'flutter build web --release'
            }
        }

        stage('Archive Web') {
            steps {
                sh 'tar -czf flutter-web.tar.gz -C build/web .'
                archiveArtifacts artifacts: 'flutter-web.tar.gz', fingerprint: true
            }
        }
    }

    post {
        success {
            echo 'Flutter Web build completed successfully!'
        }
        failure {
            echo 'Build failed. Check the logs above.'
        }
    }
}